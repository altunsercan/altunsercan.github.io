---
import BaseLayout from '../layouts/BaseLayout.astro';
import SideBar from '../components/SideBar.astro';
import PaginationPosts from '../components/PaginationPosts.astro';
import TransitionComponent from '../components/TransitionComponent.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import SearchInput from '../components/SearchInput.astro';
import CounterComponent from '../components/CounterComponent.astro';
---

<BaseLayout title="Component Tests">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">Component Migration Test</h1>
    
    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">Static Components (Converted to Astro)</h2>
      
      <div class="mb-4">
        <h3 class="text-lg font-semibold">SideBar Component:</h3>
        <SideBar>
          <div class="bg-gray-200 p-4 rounded">Content in sidebar</div>
        </SideBar>
      </div>

      <div class="mb-4">
        <h3 class="text-lg font-semibold">PaginationPosts Component:</h3>
        <PaginationPosts base="/blog" currentPage={2} totalPages={5} />
      </div>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-bold mb-4">Interactive Components (Vue Islands)</h2>
      
      <div class="mb-4">
        <h3 class="text-lg font-semibold">Search Input:</h3>
        <SearchInput />
      </div>

      <div class="mb-4">
        <h3 class="text-lg font-semibold">Counter Component:</h3>
        <CounterComponent />
      </div>

      <div class="mb-4">
        <h3 class="text-lg font-semibold">Transition Component:</h3>
        <TransitionComponent />
      </div>
    </section>
  </div>
</BaseLayout>