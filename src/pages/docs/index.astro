---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get documentation pages sorted by title
const allDocs = await getCollection('docs', ({ data }) => {
  return data.draft !== true;
});
const sortedDocs = allDocs.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Format dates
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<BaseLayout 
  title="Documentation" 
  description="Technical documentation and guides"
>
  <div class="container-inner mx-auto py-16">
    <h1 class="text-4xl font-bold mb-8">Documentation</h1>
    
    {sortedDocs.length > 0 ? (
      <div class="space-y-6">
        {sortedDocs.map(doc => (
          <div class="post border-gray-400 border-b mb-8">
            <h2 class="text-2xl font-bold mb-2">
              <a href={`/docs/${doc.slug}`} class="text-copy-primary hover:text-green-700">
                {doc.data.title}
              </a>
            </h2>
            {doc.data.date && (
              <div class="text-copy-secondary mb-4">
                <span>Updated: {formatDate(doc.data.date)}</span>
              </div>
            )}
            {doc.data.summary && (
              <div class="text-lg mb-4">
                {doc.data.summary}
              </div>
            )}
            <div class="mb-8">
              <a href={`/docs/${doc.slug}`} class="font-bold uppercase hover:text-green-700">
                Read More
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <h2 class="text-2xl font-semibold mb-4">No Documentation Available</h2>
        <p class="text-copy-secondary">Documentation content is coming soon.</p>
      </div>
    )}
  </div>
</BaseLayout>