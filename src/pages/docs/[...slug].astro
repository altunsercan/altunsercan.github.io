---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const docsEntries = await getCollection('docs');
  return docsEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

// Generate meta title
const metaTitle = entry.data.title;
const metaDescription = entry.data.summary || entry.data.excerpt || `Documentation: ${entry.data.title}`;
---

<BaseLayout 
  title={metaTitle} 
  description={metaDescription}
>
  <div class="container-inner mx-auto my-16">
    <h1 class="text-4xl font-bold leading-tight">{entry.data.title}</h1>
    {entry.data.date && (
      <div class="text-xl text-gray-600 mb-4">Last updated: {formatDate(entry.data.date)}</div>
    )}
    
    <div class="markdown-body mb-8">
      <Content />
    </div>
    
    <div class="mb-8">
      <a href="/docs" class="font-bold uppercase hover:text-green-700">Back to Documentation</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Import GitHub markdown styles */
  @import '../../css/github-markdown.css';
</style>