---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PaginationPosts from '../../components/PaginationPosts.vue';

// Get blog posts sorted by date
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Simple pagination - in the future this could be enhanced
const postsPerPage = 3;
const currentPage = 1; // TODO: Get from URL params
const startIndex = (currentPage - 1) * postsPerPage;
const endIndex = startIndex + postsPerPage;
const paginatedPosts = sortedPosts.slice(startIndex, endIndex);
const totalPages = Math.ceil(sortedPosts.length / postsPerPage);

// Format dates
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

// Calculate reading time (rough estimate: 200 words per minute)
const getReadingTime = (content: string) => {
  const wordsPerMinute = 200;
  const wordCount = content.split(/\s+/).length;
  return Math.ceil(wordCount / wordsPerMinute);
};
---

<BaseLayout 
  title="Blog" 
  description="Blog posts about game development, AI programming, and more"
>
  <div class="container-inner mx-auto py-16">
    {paginatedPosts.map(post => (
      <div class="post border-gray-400 border-b mb-12">
        <h2 class="text-3xl font-bold">
          <a href={`/blog/${post.slug}`} class="text-copy-primary hover:text-green-700">
            {post.data.title}
          </a>
        </h2>
        <div class="text-copy-secondary mb-4">
          <span>{formatDate(post.data.date)}</span>
          <span> &middot; </span>
          <span>{getReadingTime(post.body)} min read</span>
        </div>

        <div class="text-lg mb-4">
          {post.data.summary || post.data.excerpt}
        </div>

        <div class="mb-8">
          <a href={`/blog/${post.slug}`} class="font-bold uppercase hover:text-green-700">
            Read More
          </a>
        </div>
      </div>
    ))}

    {totalPages > 1 && (
      <PaginationPosts
        client:load
        base="/blog"
        totalPages={totalPages}
        currentPage={currentPage}
      />
    )}
  </div>
</BaseLayout>