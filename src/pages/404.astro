---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page Not Found - 404" 
  description="The page you are looking for does not exist."
>
  <div class="container-inner mx-auto py-16 text-center">
    <h1 class="text-6xl font-bold text-copy-primary mb-8">404</h1>
    <h2 class="text-2xl font-semibold mb-4">Page Not Found</h2>
    <p class="text-lg text-copy-secondary mb-8">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <div class="space-y-4">
      <div>
        <a 
          href="/" 
          class="inline-block bg-green-700 hover:bg-green-800 text-white font-semibold py-3 px-6 rounded"
        >
          Go Home
        </a>
      </div>
      <div>
        <a 
          href="/blog" 
          class="text-green-700 hover:text-green-800 font-semibold mr-6"
        >
          View Blog
        </a>
        <a 
          href="/portfolio" 
          class="text-green-700 hover:text-green-800 font-semibold"
        >
          View Portfolio
        </a>
      </div>
    </div>
  </div>
</BaseLayout>