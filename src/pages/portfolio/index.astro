---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PaginationPosts from '../../components/PaginationPosts.vue';

// Get portfolio items sorted by date
const allPortfolioItems = await getCollection('portfolio', ({ data }) => {
  return data.draft !== true;
});
const sortedPortfolio = allPortfolioItems.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Get unique portfolio tags
const allTags = new Set<string>();
allPortfolioItems.forEach(item => {
  if (item.data.tags) {
    item.data.tags.forEach(tag => allTags.add(tag));
  }
});
const portfolioTags = Array.from(allTags);

// Simple pagination
const itemsPerPage = 8;
const currentPage = 1; // TODO: Get from URL params
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const paginatedItems = sortedPortfolio.slice(startIndex, endIndex);
const totalPages = Math.ceil(sortedPortfolio.length / itemsPerPage);

// Format dates
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<BaseLayout 
  title="Portfolio" 
  description="Portfolio of game development projects, Unity3D games, and AI programming work by Sercan Altun"
  keywords="Portfolio, Game Development, Unity3D, C#, AI Programming, Projects, Game Design"
  canonical="https://altunsercan.github.io/portfolio/"
>
  <div class="mx-64">
    <h1 class="text-6xl font-bold">Portfolio</h1>
  </div>
  <div class="mx-64 py-4">
    <div class="flex mb-8 text-sm">
      {portfolioTags.map(tag => (
        <a
          href={`/portfolio/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`}
          class="bg-gray-300 rounded-full px-4 py-2 mr-4 hover:bg-green-300">
          {tag}
        </a>
      ))}
    </div>
  </div>

  <div class="mx-64 py-4">
    <div class="flex flex-wrap -mx-4">
      {paginatedItems.map(portfolio => (
        <div class="relative post flex-none border-gray-400 border-none px-4 w-1/4 mb-4">
          <div class="absolute invisible hover:visible z-10 p-4 bg-black bg-opacity-75 text-white rounded">
            <h2 class="text-2xl font-bold">
              <a href={`/portfolio/${portfolio.slug}`} class="text-white hover:text-green-300">
                {portfolio.data.title}
              </a>
            </h2>
          </div>
          <a href={`/portfolio/${portfolio.slug}`} class="font-bold uppercase block">
            {portfolio.data.thumbnailImage ? (
              <img 
                src={portfolio.data.thumbnailImage} 
                alt={portfolio.data.title}
                class="w-full h-48 object-cover rounded"
              />
            ) : (
              <div class="w-full h-48 bg-gray-300 rounded flex items-center justify-center">
                <span class="text-gray-600">No Image</span>
              </div>
            )}
          </a>
        </div>
      ))}
    </div>
    {totalPages > 1 && (
      <PaginationPosts
        client:load
        base="/portfolio"
        totalPages={totalPages}
        currentPage={currentPage}
      />
    )}
  </div>
</BaseLayout>