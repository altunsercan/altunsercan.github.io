---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PaginationPosts from '../../../components/PaginationPosts.vue';

export async function getStaticPaths() {
  const allPortfolio = await getCollection('portfolio');
  const uniqueTags = new Set<string>();
  
  allPortfolio.forEach(item => {
    if (item.data.tags) {
      item.data.tags.forEach(tag => {
        uniqueTags.add(tag.toLowerCase().replace(/\s+/g, '-'));
      });
    }
  });

  return Array.from(uniqueTags).map(tag => ({
    params: { tag },
    props: { tag }
  }));
}

const { tag } = Astro.props;

// Get portfolio items for this tag
const allPortfolio = await getCollection('portfolio', ({ data }) => {
  return data.draft !== true && data.tags && data.tags.some(t => 
    t.toLowerCase().replace(/\s+/g, '-') === tag
  );
});

const sortedPortfolio = allPortfolio.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Format tag name for display
const displayTag = tag.split('-').map(word => 
  word.charAt(0).toUpperCase() + word.slice(1)
).join(' ');

// Format dates
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};
---

<BaseLayout 
  title={`Portfolio tagged "${displayTag}"`}
  description={`Portfolio items tagged with ${displayTag}`}
>
  <div class="mx-64 py-16">
    <h1 class="text-4xl font-bold mb-8">Portfolio tagged "{displayTag}"</h1>
    
    {sortedPortfolio.length > 0 ? (
      <div class="flex flex-wrap -mx-4">
        {sortedPortfolio.map(portfolio => (
          <div class="relative post flex-none border-gray-400 border-none px-4 w-1/4 mb-4">
            <div class="absolute invisible hover:visible z-10 p-4 bg-black bg-opacity-75 text-white rounded">
              <h2 class="text-2xl font-bold">
                <a href={`/portfolio/${portfolio.slug}`} class="text-white hover:text-green-300">
                  {portfolio.data.title}
                </a>
              </h2>
            </div>
            <a href={`/portfolio/${portfolio.slug}`} class="font-bold uppercase block">
              {portfolio.data.thumbnailImage ? (
                <img 
                  src={portfolio.data.thumbnailImage} 
                  alt={portfolio.data.title}
                  class="w-full h-48 object-cover rounded"
                />
              ) : (
                <div class="w-full h-48 bg-gray-300 rounded flex items-center justify-center">
                  <span class="text-gray-600">No Image</span>
                </div>
              )}
            </a>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <h2 class="text-2xl font-semibold mb-4">No portfolio items found</h2>
        <p class="text-copy-secondary">There are no portfolio items with this tag.</p>
      </div>
    )}
    
    <div class="mt-8">
      <a href="/portfolio" class="font-bold uppercase hover:text-green-700">← Back to Portfolio</a>
    </div>
  </div>
</BaseLayout>