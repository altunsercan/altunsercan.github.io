---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const portfolioEntries = await getCollection('portfolio');
  return portfolioEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Format date
const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'long', 
    day: 'numeric' 
  });
};

// Generate meta title
const metaTitle = entry.data.title;
const metaDescription = entry.data.summary || entry.data.excerpt || `Portfolio item: ${entry.data.title}`;
---

<BaseLayout 
  title={metaTitle} 
  description={metaDescription}
>
  <div class="container-inner mx-auto my-16">
    <h1 class="text-4xl font-bold leading-tight">{entry.data.title}</h1>
    <div class="text-xl text-gray-600 mb-4">{formatDate(entry.data.date)}</div>
    
    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="flex mb-8 text-sm">
        {entry.data.tags.map(tag => (
          <a
            href={`/portfolio/tag/${tag.toLowerCase().replace(/\s+/g, '-')}`}
            class="bg-gray-300 rounded-full px-4 py-2 mr-4 hover:bg-green-300">
            {tag}
          </a>
        ))}
      </div>
    )}
    
    {entry.data.thumbnailImage && (
      <div class="mb-8">
        <img 
          src={entry.data.thumbnailImage} 
          alt={entry.data.title}
          class="w-full max-w-2xl mx-auto rounded-lg shadow-lg"
        />
      </div>
    )}
    
    <div class="markdown-body mb-8">
      <Content />
    </div>
    
    <div class="mb-8">
      <a href="/portfolio" class="font-bold uppercase hover:text-green-700">Back to Portfolio</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* Import GitHub markdown styles */
  @import '../../css/github-markdown.css';
</style>