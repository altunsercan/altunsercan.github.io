---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Portfolio" 
  description="Portfolio of game development projects by Sercan Altun"
>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8">Portfolio</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-background-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Test Project 1</h3>
        <p class="text-copy-secondary">This is a placeholder for the portfolio migration.</p>
      </div>
      
      <div class="bg-background-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Test Project 2</h3>
        <p class="text-copy-secondary">Responsive design test with multiple cards.</p>
      </div>
      
      <div class="bg-background-secondary p-6 rounded-lg">
        <h3 class="text-xl font-semibold mb-3">Test Project 3</h3>
        <p class="text-copy-secondary">Grid layout should work on all screen sizes.</p>
      </div>
    </div>
  </main>
</BaseLayout>